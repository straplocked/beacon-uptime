# Copy to .env before `docker compose -f docker-compose.prod.yml up -d` —
# see docs/DEPLOYMENT.md. Every value here is read by docker-compose.prod.yml
# via ${VAR} interpolation, not by the app directly.

# Postgres (the `db` service's own credentials; TimescaleDB image)
POSTGRES_PASSWORD=generate-a-strong-random-password

# Redis (the `redis` service's own password — requirepass)
REDIS_PASSWORD=generate-a-strong-random-password

# App
BASE_URL=https://status.yourdomain.com
SESSION_SECRET=generate-a-random-64-char-string

# Email (Brevo)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
FROM_EMAIL=alerts@yourdomain.com

# Optional: probe region identifier tagged onto check results
PROBE_REGION=us-east

# Optional: days of raw check results kept before cleanup (default: 365)
DATA_RETENTION_DAYS=365

# Optional (default: true, i.e. unset). Self-hosted installs commonly
# monitor their own LAN, so private/loopback/reserved targets are allowed
# by default. Set to exactly "false" for a hosted/multi-tenant install —
# see the "Security: hosted / multi-tenant installs" section in
# docs/DEPLOYMENT.md.
# ALLOW_PRIVATE_TARGETS=false

# Optional: where the `backup` service's daily pg_dumps are written.
# On Unraid, point this at the parity-protected array, e.g.
# /mnt/user/appdata/beacon/backups
BACKUP_PATH=./backups
