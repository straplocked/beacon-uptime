# Database
DATABASE_URL=postgresql://beacon:beacon@localhost:5433/beacon

# Redis
REDIS_URL=redis://localhost:6380

# App
BASE_URL=https://beacon.pluginsynthesis.com
SESSION_SECRET=generate-a-random-64-char-string

# Email (Brevo)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
FROM_EMAIL=alerts@pluginsynthesis.com

# Optional: probe region identifier
PROBE_REGION=us-east

# Optional: days of raw check results kept before cleanup (default: 365)
DATA_RETENTION_DAYS=365

# Sign-up is open only until the first account exists. true = keep it open.
ALLOW_REGISTRATION=false

# Unset (default) = true: monitors may target private/loopback/reserved
# addresses (192.168.x.x, 127.0.0.1, etc) directly — the normal case for a
# self-hosted install monitoring its own LAN. Set to exactly "false" to
# route every check through the same SSRF guard used for user-supplied
# URLs elsewhere, refusing any target that resolves to a private address.
# Hosted/multi-tenant installs, where monitor targets are also
# attacker-influenced, should set this to false. See docs/DEPLOYMENT.md.
# ALLOW_PRIVATE_TARGETS=false
